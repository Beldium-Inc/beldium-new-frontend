    "http_status": 400,
    "body": {
      "status": "failed",
      "message": "quantity_mt: Ensure this value is greater than 0.",
      "error": {
        "code": "validation_error",
        "details": {
          "quantity_mt": ["Ensure this value is greater than 0."],
          "declaration_points": ["All five points must be ticked."]
        }
      }
    }
  },

