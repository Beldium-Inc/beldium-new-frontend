{
  "_about": {
    "purpose": "One example success response for each endpoint in docs/api_contract_r1.md, so the frontend can be built before the backend is ready. Keys are the endpoint number, method and path from that file.",
    "written": "2026-10-10",
    "warnings": [
      "Every company, person, licence number and id here is made up.",
      "Field names marked PROPOSED or PACK LABEL in the contract are not yet checked against the Data Dictionary (PDD-015).",
      "A null value with is_placeholder true means Q&C has not supplied the rule. Do not replace it with a guess.",
      "The batch_id and partner_id formats are placeholders. The real formats wait for the mineral codes and ID sequence rules."
    ],
    "base_path": "/api/v1"
  },

  "error_example": {
    "http_status": 409,
    "body": {
      "status": "failed",
      "message": "This declaration is locked. A correction needs a new declaration.",
      "error": { "code": "batch_locked", "details": null }
    }
  },

