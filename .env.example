# Copy this file to .env for local development. Do not put real secrets here.
# VITE_* values are public once the app is built, so never store secrets in them.

# Origin of the Beldium Django API, without the /api/v1 suffix.
# Required for production and CI builds. Local dev falls back to http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Minutes of inactivity before sign out (optional, default 15, capped at 25).
# VITE_SESSION_IDLE_MINUTES=15
