# Copy this file to .env for local development. VITE_* values are public once
# the app is built, so never store secrets in them.

# Origin of the Beldium Django API (no /api/v1 suffix).
VITE_API_URL=http://localhost:8000

# Where the "Get help" link in every portal header points (OR-013). One value per
# Vercel project; the same name in all three apps. Use an https:// help desk page
# or a mailto: address. Unset, it opens an email to support@beldium.com.
# VITE_SUPPORT_URL=https://help.beldium.com
